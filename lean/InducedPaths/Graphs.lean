/-
Concrete graphs named in the preprint: the Petersen graph and its one-vertex deletion,
`H₈`, `Γₕ`, the Chen–Xu list `𝔉`, leaf attachments, and the radius-4 extension of Theorem 4.2.
-/
module

public import InducedPaths.Defs
public import Mathlib.Combinatorics.SimpleGraph.Star
public import Mathlib.Tactic.DeriveFintype

open Classical
open scoped SimpleGraph
open SimpleGraph

@[expose] public section

namespace InducedPaths

variable {V : Type*}

/-- Symmetric irreflexive relation generated by an arbitrary specification `r`. -/
def simpleOf {V : Type*} (r : V → V → Prop) : SimpleGraph V where
  Adj a b := a ≠ b ∧ (r a b ∨ r b a)
  symm := ⟨fun _ _ h => ⟨h.1.symm, h.2.symm⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

/-- A fresh leaf adjacent only to `root`. -/
def addLeaf (G : SimpleGraph V) (root : V) : SimpleGraph (Option V) :=
  simpleOf fun
    | none, some v => v = root
    | some v, none => v = root
    | some u, some w => G.Adj u w
    | none, none => False

/-- Vertices of the Petersen graph: the 2-element subsets of a 5-element set. -/
abbrev PetersenVertex := {s : Finset (Fin 5) // s.card = 2}

/-- The Petersen graph. Distinct vertices are adjacent when their pairs are disjoint. -/
def petersenGraph : SimpleGraph PetersenVertex where
  Adj s t := Disjoint s.1 t.1
  symm := ⟨fun s t h => Disjoint.symm h⟩
  loopless := ⟨fun s h => by
    have hs : s.1 = ∅ := disjoint_self.mp h
    have : s.1.card = 0 := by simp [hs]
    have : s.1.card = 2 := s.2
    omega⟩

instance : DecidableRel petersenGraph.Adj := fun s t =>
  decidable_of_iff (Disjoint s.1 t.1) Iff.rfl

/-- The pair `{0,1}`, used as the deleted vertex of `P - v` and as a leaf hub. -/
def petersenHub : PetersenVertex :=
  ⟨{0, 1}, by decide⟩

/-- The pair `{2,3}`, adjacent to `petersenHub` and used as the other end of that edge. -/
def petersenHubB : PetersenVertex :=
  ⟨{2, 3}, by decide⟩

/-- `P - v`, the Petersen graph with one vertex deleted. -/
def petersenDelete (v : PetersenVertex) : SimpleGraph {s : PetersenVertex // s ≠ v} :=
  petersenGraph.induce {s | s ≠ v}

/-- `P - v` at the fixed hub `{0,1}`. -/
def petersenMinus : SimpleGraph {s : PetersenVertex // s ≠ petersenHub} :=
  petersenDelete petersenHub

/-- Vertices of `Γₕ`: a 6-cycle, one apex, and `h` leaves at the apex. -/
inductive GammaV (h : ℕ) where
  | cycle : Fin 6 → GammaV h
  | apex : GammaV h
  | leaf : Fin h → GammaV h
  deriving DecidableEq, Fintype

/-- `Γₕ` from Theorem 3.6: the apex meets one antipodal pair of the 6-cycle, and the leaves
meet only the apex. `Γ₀` is the order-7 extremal graph; `Γ_{n-7}` is the extremal graph for
`n ≥ 11`. -/
def gammaGraph (h : ℕ) : SimpleGraph (GammaV h) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 6).Adj i j
    | .cycle i, .apex => i = 0 ∨ i = 3
    | .apex, .cycle i => i = 0 ∨ i = 3
    | .leaf _, .apex => True
    | .apex, .leaf _ => True
    | _, _ => False

/-- Vertices of `H₈`: a 6-cycle plus two vertices on distinct antipodal pairs. -/
inductive H8V where
  | cycle : Fin 6 → H8V
  | extra : Fin 2 → H8V
  deriving DecidableEq, Fintype

/-- `H₈`, the unique order-8 extremal graph of Theorem 3.6. -/
def h8Graph : SimpleGraph H8V :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 6).Adj i j
    | .extra 0, .cycle i => i = 0 ∨ i = 3
    | .cycle i, .extra 0 => i = 0 ∨ i = 3
    | .extra 1, .cycle i => i = 1 ∨ i = 4
    | .cycle i, .extra 1 => i = 1 ∨ i = 4
    | _, _ => False

/-- `C₅` with one pendant leaf, the second order-6 extremal graph of Theorem 3.6. -/
def c5PlusLeaf : SimpleGraph (Option (Fin 5)) :=
  addLeaf (cycleGraph 5) 0

/-- `K₂`. -/
abbrev k2Graph : SimpleGraph (Fin 2) := completeGraph (Fin 2)

/-- `P₃`. -/
abbrev p3Graph : SimpleGraph (Fin 3) := pathGraph 3

/-- `P₄`. -/
abbrev p4Graph : SimpleGraph (Fin 4) := pathGraph 4

/-- `K₁,₃`, the star on four vertices. -/
abbrev clawGraph : SimpleGraph (Fin 4) := starGraph (0 : Fin 4)

/-- Petersen graph with `a` leaves at `{0,1}` and `b` leaves at `{2,3}`.
Theorem 5.6 uses the case `b = 0` (one hub) and the case of both hubs, which are adjacent. -/
inductive PetersenLeaves (a b : ℕ) where
  | core : PetersenVertex → PetersenLeaves a b
  | leafA : Fin a → PetersenLeaves a b
  | leafB : Fin b → PetersenLeaves a b
  deriving DecidableEq, Fintype

def petersenWithLeaves (a b : ℕ) : SimpleGraph (PetersenLeaves a b) :=
  simpleOf fun
    | .core s, .core t => petersenGraph.Adj s t
    | .leafA _, .core s => s = petersenHub
    | .core s, .leafA _ => s = petersenHub
    | .leafB _, .core s => s = petersenHubB
    | .core s, .leafB _ => s = petersenHubB
    | _, _ => False

/-! ### Chen–Xu family `𝔉` -/

/-- `F₂`: a 5-cycle with equal stable sets `A₁`, `A₃` of order `t`, a perfect matching between
them, and the spokes of the paper (`v₁ = 0`, `v₃ = 2`). The family member requires `t > 0`. -/
inductive F2V (t : ℕ) where
  | cycle : Fin 5 → F2V t
  | A1 : Fin t → F2V t
  | A3 : Fin t → F2V t
  deriving DecidableEq, Fintype

def f2Graph (t : ℕ) : SimpleGraph (F2V t) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 5).Adj i j
    | .A1 _, .cycle j => j = 0
    | .cycle j, .A1 _ => j = 0
    | .A3 _, .cycle j => j = 2
    | .cycle j, .A3 _ => j = 2
    | .A1 i, .A3 j => i = j
    | .A3 j, .A1 i => i = j
    | _, _ => False

/-- A leaf at a hub `v₁` of `F₂`. -/
def f2HubLeaf (t : ℕ) : SimpleGraph (Option (F2V t)) :=
  addLeaf (f2Graph t) (.cycle 0)

/-- A leaf at `v₂`, the midpoint of the unique 2-edge branch of `F₂`. -/
def f2MidLeaf (t : ℕ) : SimpleGraph (Option (F2V t)) :=
  addLeaf (f2Graph t) (.cycle 1)

/-- `F'₀`: a 6-cycle with equal stable sets `Y₁`, `Y₄` of order `t'` and a perfect matching.
`v₁ = 0` and `v₄ = 3`. -/
inductive F0pV (t : ℕ) where
  | cycle : Fin 6 → F0pV t
  | Y1 : Fin t → F0pV t
  | Y4 : Fin t → F0pV t
  deriving DecidableEq, Fintype

def f0pGraph (t : ℕ) : SimpleGraph (F0pV t) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 6).Adj i j
    | .Y1 _, .cycle j => j = 0
    | .cycle j, .Y1 _ => j = 0
    | .Y4 _, .cycle j => j = 3
    | .cycle j, .Y4 _ => j = 3
    | .Y1 i, .Y4 j => i = j
    | .Y4 j, .Y1 i => i = j
    | _, _ => False

/-- `F₃`: the 5-cycle plus the path `a₃a₁a₄`, with `aᵢ` adjacent to `vᵢ`. -/
inductive F3V where
  | cycle : Fin 5 → F3V
  | a3 | a1 | a4
  deriving DecidableEq, Fintype

def f3Graph : SimpleGraph F3V :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 5).Adj i j
    | .a3, .a1 => True
    | .a1, .a4 => True
    | .a1, .cycle i => i = 0
    | .a3, .cycle i => i = 2
    | .a4, .cycle i => i = 3
    | _, _ => False

/-- `F₄`: `F₃` plus `a₅` adjacent to `a₃` and to `v₅`. -/
inductive F4V where
  | cycle : Fin 5 → F4V
  | a5 | a3 | a1 | a4
  deriving DecidableEq, Fintype

def f4Graph : SimpleGraph F4V :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 5).Adj i j
    | .a5, .a3 => True
    | .a3, .a1 => True
    | .a1, .a4 => True
    | .a5, .cycle i => i = 4
    | .a3, .cycle i => i = 2
    | .a1, .cycle i => i = 0
    | .a4, .cycle i => i = 3
    | _, _ => False

/-- Vertices of a 7-cycle plus `k` extra vertices, for `F₇`–`F₁₂`. -/
inductive C7X (k : ℕ) where
  | cycle : Fin 7 → C7X k
  | extra : Fin k → C7X k
  deriving DecidableEq, Fintype

/-- `xᵢ` meets `{vᵢ, vᵢ₊₃}` on the 7-cycle, with `v₁ = 0`. -/
def c7Spoke (i j : Fin 7) : Prop := j = i ∨ j = i + 3

/-- `F₇`: `C₇` plus `x₁`. -/
def f7Graph : SimpleGraph (C7X 1) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 7).Adj i j
    | .extra 0, .cycle j => c7Spoke 0 j
    | _, _ => False

/-- `F₈`: `C₇` plus nonadjacent `x₁`, `x₂`. -/
def f8Graph : SimpleGraph (C7X 2) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 7).Adj i j
    | .extra 0, .cycle j => c7Spoke 0 j
    | .extra 1, .cycle j => c7Spoke 1 j
    | _, _ => False

/-- `F₉`: `F₈` plus a vertex adjacent only to `x₁` and `x₂`. -/
def f9Graph : SimpleGraph (C7X 3) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 7).Adj i j
    | .extra 0, .cycle j => c7Spoke 0 j
    | .extra 1, .cycle j => c7Spoke 1 j
    | .extra 2, .extra j => j = 0 ∨ j = 1
    | _, _ => False

/-- `F₁₀`: `C₇` plus nonadjacent `x₁`, `x₅`. Here `x₅` has index `4`. -/
def f10Graph : SimpleGraph (C7X 2) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 7).Adj i j
    | .extra 0, .cycle j => c7Spoke 0 j
    | .extra 1, .cycle j => c7Spoke 4 j
    | _, _ => False

/-- `F₁₁`: `C₇` plus a stable set `{x₁, x₂, x₅}`. -/
def f11Graph : SimpleGraph (C7X 3) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 7).Adj i j
    | .extra 0, .cycle j => c7Spoke 0 j
    | .extra 1, .cycle j => c7Spoke 1 j
    | .extra 2, .cycle j => c7Spoke 4 j
    | _, _ => False

/-- `F₁₂`: `F₁₁` plus a vertex adjacent only to `x₁` and `x₂`. -/
def f12Graph : SimpleGraph (C7X 4) :=
  simpleOf fun
    | .cycle i, .cycle j => (cycleGraph 7).Adj i j
    | .extra 0, .cycle j => c7Spoke 0 j
    | .extra 1, .cycle j => c7Spoke 1 j
    | .extra 2, .cycle j => c7Spoke 4 j
    | .extra 3, .extra j => j = 0 ∨ j = 1
    | _, _ => False

/-- Membership in `𝔉 = {F₀, F'₀, F₁, …, F₁₂}`, up to isomorphism.
`F₀ = C₆`, `F₁ = C₅`, `F₅` is the Petersen graph, and `F₆ = C₇`. -/
def InChenXuFamily {V : Type*} (G : SimpleGraph V) : Prop :=
  Nonempty (G ≃g cycleGraph 6) ∨
  Nonempty (G ≃g cycleGraph 5) ∨
  Nonempty (G ≃g petersenGraph) ∨
  Nonempty (G ≃g cycleGraph 7) ∨
  (∃ t, 0 < t ∧ Nonempty (G ≃g f2Graph t)) ∨
  (∃ t, 0 < t ∧ Nonempty (G ≃g f0pGraph t)) ∨
  Nonempty (G ≃g f3Graph) ∨
  Nonempty (G ≃g f4Graph) ∨
  Nonempty (G ≃g f7Graph) ∨
  Nonempty (G ≃g f8Graph) ∨
  Nonempty (G ≃g f9Graph) ∨
  Nonempty (G ≃g f10Graph) ∨
  Nonempty (G ≃g f11Graph) ∨
  Nonempty (G ≃g f12Graph)

/-! ### Radius 4 extension (Theorem 4.2) and `θₖ` -/

/-- The data of the 6-cycle extension in Theorem 4.2. `C₈` is not an instance of this
structure: it is the other branch of the classification. -/
structure RadiusFourExtension (G : SimpleGraph V) where
  cycleEmb : Fin 6 ↪ V
  cycle_induced : ∀ i j, G.Adj (cycleEmb i) (cycleEmb j) ↔ (cycleGraph 6).Adj i j
  attach : Fin 6 → Set V
  attach_nonempty : ∀ i, (attach i).Nonempty
  attach_off_cycle : ∀ i v, v ∈ attach i → ∀ j, cycleEmb j ≠ v
  attach_pairwise : ∀ ⦃i j⦄, i ≠ j → Disjoint (attach i) (attach j)
  trace : ∀ i v, v ∈ attach i → ∀ j, G.Adj v (cycleEmb j) ↔ j = i
  no_cross : ∀ ⦃i j⦄, i ≠ j → ∀ v ∈ attach i, ∀ w ∈ attach j, ¬ G.Adj v w
  matching : ∀ i v, v ∈ attach i → ∀ w ∈ attach i, G.Adj v w →
    ∀ w' ∈ attach i, G.Adj v w' → w' = w
  no_extra_attach : ∀ i v w, v ∈ attach i → G.Adj v w → w = cycleEmb i ∨ w ∈ attach i
  edgeVert : Fin 6 → Option V
  edge_off_cycle : ∀ i v, edgeVert i = some v → ∀ j, cycleEmb j ≠ v
  edge_off_attach : ∀ i v j w, edgeVert i = some v → w ∈ attach j → v ≠ w
  edge_inj : ∀ i j v, edgeVert i = some v → edgeVert j = some v → i = j
  edge_adj : ∀ i v, edgeVert i = some v → ∀ w, G.Adj v w ↔ w = cycleEmb i ∨ w = cycleEmb (i + 1)
  exhaustive : ∀ v, (∃ i, cycleEmb i = v) ∨ (∃ i, v ∈ attach i) ∨ (∃ i, edgeVert i = some v)

def IsRadiusFourExtension (G : SimpleGraph V) : Prop := Nonempty (RadiusFourExtension G)

/-- `b`, the number of vertices added on edges of the 6-cycle. -/
noncomputable def addedCount {G : SimpleGraph V} (E : RadiusFourExtension G) : ℕ :=
  (Finset.univ.filter fun i : Fin 6 => (E.edgeVert i).isSome).card

/-- `m`, the number of matching edges in the sets `Cᵢ`. -/
noncomputable def matchingCount {G : SimpleGraph V} [Fintype V] [DecidableEq V]
    (E : RadiusFourExtension G) : ℕ :=
  ∑ i : Fin 6, edgeCount (G.induce (E.attach i))

/-- Vertices of `θₖ`: two poles and `k` internally disjoint paths of length 3. -/
inductive ThetaV (k : ℕ) where
  | x | y
  | a : Fin k → ThetaV k
  | b : Fin k → ThetaV k
  deriving DecidableEq, Fintype

/-- `θₖ` from Proposition 6.2. -/
def thetaGraph (k : ℕ) : SimpleGraph (ThetaV k) :=
  simpleOf fun
    | .x, .a _ => True
    | .a i, .b j => i = j
    | .b _, .y => True
    | _, _ => False

end InducedPaths
